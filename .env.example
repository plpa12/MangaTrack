# Leave blank for local demo mode. Never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret; never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Set to "supabase" only after configuring migrations and environment.
MANGATRACK_DATA_MODE=local
# Comma-separated UUIDs of authorized admin users after Supabase Auth is configured.
MANGATRACK_ADMIN_USER_IDS=